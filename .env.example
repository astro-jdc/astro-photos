# Copia a .env para desarrollo local. Nunca comitear .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Base de datos
DATABASE_URL=postgresql+asyncpg://astro:astro@localhost:5432/astrophotos

# Almacenamiento (MinIO en local, S3 en AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET_UPLOADS=astro-photos-dev-uploads
S3_BUCKET_ORIGINALS=astro-photos-dev-originals
S3_BUCKET_DERIVED=astro-photos-dev-derived
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Colas
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_INGEST=astro-photos-dev-ingest
SQS_QUEUE_RECONSTRUCT=astro-photos-dev-reconstruct

# Auth: en dev se usa un emisor JWT local, en AWS Cognito
AUTH_MODE=local
JWT_SECRET=cambia-esto-en-local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=eu-west-1

# Límites
MAX_UPLOAD_BYTES=536870912
DEFAULT_USER_QUOTA_BYTES=21474836480
MAX_QUEUED_JOBS_PER_USER=5
MAX_JOBS_PER_DAY=20

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
