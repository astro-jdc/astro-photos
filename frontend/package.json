{
  "name": "@astro-photos/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css}\"",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o app/types/api.gen.ts"
  },
  "dependencies": {
    "@nuxt/image": "2.1.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@pinia/nuxt": "1.0.2",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "exifr": "7.1.3",
    "maplibre-gl": "6.7.0",
    "nuxt": "4.5.2",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.2.0",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.13.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
